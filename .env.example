# Kopieren nach .env und bei Bedarf anpassen:
#   cp .env.example .env

# --- Image-Versionen (gepinnt statt :latest, siehe README "Updates") ---------
# Stand: 2026-08
OLLAMA_IMAGE=ollama/ollama:0.33.1
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.1
# CPU-Variante. Soll Docling die NVIDIA-GPU mitnutzen (schnellere OCR),
# stattdessen die CUDA-Variante eintragen, z. B.:
#   ghcr.io/docling-project/docling-serve-cu124:v1.31.0
DOCLING_IMAGE=ghcr.io/docling-project/docling-serve:v1.31.0
# Vektordatenbank für die eigene RAG-Pipeline (README §7, Variante B):
CHROMA_IMAGE=chromadb/chroma:1.5.9

# --- Ollama-Tuning (Defaults für 4 GB VRAM, siehe README §4) -----------------
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_LOADED_MODELS=1

# --- Open WebUI --------------------------------------------------------------
# Nach dem Anlegen des Admin-Accounts auf false setzen, sonst kann sich
# jeder im LAN selbst registrieren:
ENABLE_SIGNUP=true

# --- Allgemein ---------------------------------------------------------------
TZ=Europe/Berlin
