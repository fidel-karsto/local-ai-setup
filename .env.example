# Kopieren nach .env und bei Bedarf anpassen:
#   cp .env.example .env

# --- Image-Versionen (gepinnt statt :latest, siehe README "Updates") ---------
# Stand: 2026-08
OLLAMA_IMAGE=ollama/ollama:0.33.1
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.1
# CPU-Variante. Soll Docling die NVIDIA-GPU mitnutzen (schnellere OCR),
# stattdessen die CUDA-Variante eintragen, z. B.:
#   ghcr.io/docling-project/docling-serve-cu124:v1.31.0
DOCLING_IMAGE=ghcr.io/docling-project/docling-serve:v1.31.0
# Vektordatenbank für die eigene RAG-Pipeline (README §7, Variante B):
CHROMA_IMAGE=chromadb/chroma:1.5.9

# --- Ollama-Tuning (Defaults für 4 GB VRAM, siehe README §4) -----------------
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_LOADED_MODELS=1

# --- Open WebUI --------------------------------------------------------------
# Beim ERSTEN Start muss das "true" sein, sonst lässt sich kein Admin-Account
# anlegen. Zum Abschalten danach die Admin-Einstellungen benutzen: ein Ändern
# auf "false" an dieser Stelle wirkt bei einer bereits laufenden Installation
# NICHT mehr (Open WebUI liest den Wert nur beim allerersten Start hier).
ENABLE_SIGNUP=true
# Standardrolle neuer Konten. "pending" heißt: ein Admin muss freigeben.
DEFAULT_USER_ROLE=pending

# --- ChromaDB (RAG-Variante B) -----------------------------------------------
# Host-Port des Chroma-Containers. Nur der Indexer auf dem Host braucht ihn;
# das Open-WebUI-Werkzeug geht über das Compose-Netz auf http://chroma:8000 und
# bleibt davon unberührt. Umlegen, falls 8000 schon belegt ist — Achtung: ein
# fremder Container auf 0.0.0.0:8000 blockiert auch das hiesige 127.0.0.1:8000
# ("port is already allocated"). Belegung prüfen mit:
#   lsof -nP -iTCP:8000 -sTCP:LISTEN
# Nach einer Änderung CHROMA_URL des Indexers mitziehen (systemd-Unit bzw.
# launchd-plist), sonst läuft der Nachtlauf ins Leere.
CHROMA_HOST_PORT=8000

# --- Allgemein ---------------------------------------------------------------
TZ=Europe/Berlin
